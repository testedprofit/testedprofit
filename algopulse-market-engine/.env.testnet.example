# Safe TestNet Access profile (connect-only wallets). Copy into a local .env;
# never commit a populated environment file or wallet secret.
# Wallet phase: Pera/Defly connect + read account state only.
# No signing, submission, opt-in transactions, or live trading.
APP_ENV=testnet
APP_NAME=AlgoPulse Market Engine
LOG_LEVEL=info

ALGORAND_NETWORK=testnet
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=

ALGO_PULSE_CONNECTORS=tinyman,pact
ENABLE_SCANNER=true
ENABLE_EXECUTION=false
ENABLE_SIGNER=false
KILL_SWITCH=true
ALGO_PULSE_EXECUTE_APPROVED=false
ALGO_PULSE_ALLOW_API_EXECUTION=false
ALGO_PULSE_UNSIGNED_EXECUTOR_ONLY=true

# Paper-arb loop uses 1/5/10 ALGO quote sizes by default.
ALGO_PULSE_TRADE_SIZES=1,5,10

# TestNet USDC is configured only as a read-only quote anchor. Asset 10458941
# resolved as USDC/6 decimals in the TestNet Indexer on 2026-07-09; re-verify it
# before staging. Add the TestNet PNET ASA after a human creates/reviews it.
PNET_ASA_ID=0
ALGO_PULSE_ASSET_PAIRS=0-10458941
ALGO_PULSE_ALLOWED_ASSET_IDS=0,10458941
# Leave empty for ambient scanner; paper_arb_loop scopes allowlist to discovered app IDs.
ALGO_PULSE_ALLOWED_APP_IDS=
ALGO_PULSE_REQUIRE_APP_ID_ALLOWLIST=true
ALGO_PULSE_USE_VESTIGE_DISCOVERY=false

PUBLIC_ROUTE_DELAY_SECONDS=900
QUOTE_MAX_AGE_SECONDS=5
MAX_TRADE_ALGO=10
MAX_DAILY_LOSS_ALGO=20
MAX_DAILY_TRADES=20
MAX_ROUTE_LENGTH=3
MIN_PROFIT_ALGO=0.25
MIN_PROFIT_BPS=35
MAX_PRICE_IMPACT_BPS=50

# Wallet connection is connect-only (Pera/Defly). Do not add a mnemonic or signing key.
ADMIN_WALLET_ALLOWLIST=
PNET_FEE_RECEIVER_ADDRESS=TESTNET_RECEIVER_REVIEW_REQUIRED
PNET_FEE_APP_ID=pending

ALGOPULSE_X402_TESTNET_ENABLED=false
ALGOPULSE_X402_TESTNET_CONFIG_CONFIRMED=false
ALGOPULSE_X402_MODE=mock
