# Fail-closed MainNet READ-ONLY staging profile.
# Copy to a local .env.mainnet-readonly (never commit real secrets).
# No mnemonic, signer, execution, or transaction submission is allowed.
APP_ENV=mainnet-readonly
APP_NAME=AlgoPulse Market Engine
LOG_LEVEL=info

ALGORAND_NETWORK=mainnet
ALGOD_URL=https://mainnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://mainnet-idx.algonode.cloud
INDEXER_TOKEN=

ALGO_PULSE_CONNECTORS=tinyman,pact
ENABLE_SCANNER=true
ENABLE_EXECUTION=false
ENABLE_SIGNER=false
KILL_SWITCH=true
ALGO_PULSE_EXECUTE_APPROVED=false
ALGO_PULSE_ALLOW_API_EXECUTION=false
ALGO_PULSE_UNSIGNED_EXECUTOR_ONLY=true

# Standard quote sizes for research paper trading.
ALGO_PULSE_TRADE_SIZES=1,5,10

# Allowlisted research pairs: ALGO/PNET, ALGO/USDC (MainNet ASA IDs).
# Do not expand without human review of liquidity and app IDs.
PNET_ASA_ID=3169177585
ALGO_PULSE_ASSET_PAIRS=0-3169177585,0-31566704
ALGO_PULSE_ALLOWED_ASSET_IDS=0,3169177585,31566704
# Leave empty so paper loop scopes to discovered Tinyman/Pact app IDs for paper-only evidence.
ALGO_PULSE_ALLOWED_APP_IDS=
ALGO_PULSE_REQUIRE_APP_ID_ALLOWLIST=true
ALGO_PULSE_USE_VESTIGE_DISCOVERY=false

PUBLIC_ROUTE_DELAY_SECONDS=900
QUOTE_MAX_AGE_SECONDS=5
MAX_TRADE_ALGO=10
MAX_DAILY_LOSS_ALGO=20
MAX_DAILY_TRADES=20
MAX_ROUTE_LENGTH=3
MIN_PROFIT_ALGO=0.25
MIN_PROFIT_BPS=35
MAX_PRICE_IMPACT_BPS=50

# No wallet keys. Admin review remains local-mock until wallet gate is reviewed.
ADMIN_WALLET_ALLOWLIST=
PNET_FEE_RECEIVER_ADDRESS=MAINNET_RECEIVER_REVIEW_REQUIRED
PNET_FEE_APP_ID=pending

ALGOPULSE_X402_TESTNET_ENABLED=false
ALGOPULSE_X402_TESTNET_CONFIG_CONFIRMED=false
ALGOPULSE_X402_MODE=mock
