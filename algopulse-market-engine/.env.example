APP_ENV=local
APP_NAME=AlgoPulse Market Engine
LOG_LEVEL=info

ALGORAND_NETWORK=mainnet
ALGOD_URL=
ALGOD_TOKEN=
INDEXER_URL=
INDEXER_TOKEN=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algopulse
REDIS_URL=redis://localhost:6379/0

ENABLE_SCANNER=true
ENABLE_EXECUTION=false
ENABLE_SIGNER=false
KILL_SWITCH=true

PNET_ASA_ID=3169177585
PNET_FEE_RECEIVER_ADDRESS=PLATFORM_FEE_WALLET_REVIEW
PNET_FEE_APP_ID=pending
ADMIN_WALLET_ALLOWLIST=ADMIN6H2ZREVIEWWALLET9KX4CONTROL
PUBLIC_ROUTE_DELAY_SECONDS=900

MAX_TRADE_ALGO=10
MAX_DAILY_LOSS_ALGO=20
MAX_DAILY_TRADES=20
MAX_ROUTE_LENGTH=3
MIN_PROFIT_ALGO=0.25
MIN_PROFIT_BPS=35
MAX_PRICE_IMPACT_BPS=50
QUOTE_MAX_AGE_SECONDS=5

# --- Gate 3: x402 TestNet (managed GoPlausible + Algorand TestNet USDC) ---
# Disabled by default. BOTH flags must be "true" to activate; otherwise mock mode (fail-closed).
ALGOPULSE_X402_TESTNET_ENABLED=false
ALGOPULSE_X402_TESTNET_CONFIG_CONFIRMED=false
ALGOPULSE_X402_MODE=mock
ALGOPULSE_X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
ALGOPULSE_X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
ALGOPULSE_X402_ASSET_ID=10458941
ALGOPULSE_X402_ASSET_SYMBOL=USDC
ALGOPULSE_X402_ASSET_DECIMALS=6
ALGOPULSE_X402_AMOUNT=$0.01
ALGOPULSE_X402_RECEIVER=CIVTUU6KLTYO26SPVEBDFBKP3UMZM2DPEO5RINODUVCI5NVIFC6HVNWS7E
ALGOPULSE_X402_RESOURCE=algopulse.market_pulse.daily.v0
# Operator-owned, LOCAL .env ONLY. Never commit a real mnemonic (client smoke only):
# ALGOPULSE_X402_PAYER_MNEMONIC=<operator-testnet-only-never-commit>
