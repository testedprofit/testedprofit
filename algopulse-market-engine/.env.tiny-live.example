ALGO_PULSE_ENV=production
ALGO_PULSE_DATA_DIR=/app/data
ALGO_PULSE_DATABASE=/app/data/market.db
ALGO_PULSE_CONNECTORS=tinyman,pact
ALGO_PULSE_NETWORK=mainnet

# Step 10 starts ALGO/USDC only. No PNET target, no broad ASA sweep.
ALGO_PULSE_ASSET_PAIRS=0-31566704
ALGO_PULSE_ALLOWED_ASSET_IDS=0,31566704
ALGO_PULSE_TARGET_ASSET_ID=31566704
ALGO_PULSE_USE_VESTIGE_DISCOVERY=false

ALGO_PULSE_SCANNER_INTERVAL_SECONDS=15
ALGO_PULSE_PUBLIC_DELAY_SECONDS=120
ALGO_PULSE_SLIPPAGE_BPS=50
ALGO_PULSE_TRADE_SIZES=1,5,10,25,50,100

ALGO_PULSE_ALGOD_URL=https://mainnet-api.algonode.cloud
ALGO_PULSE_INDEXER_URL=https://mainnet-idx.algonode.cloud
ALGO_PULSE_ALGOD_TOKEN=
ALGO_PULSE_INDEXER_TOKEN=

# Execution remains dry-run until the signer process and first manual route are reviewed.
ALGO_PULSE_ENABLE_LIVE_EXECUTION=false
ALGO_PULSE_EXECUTE_APPROVED=false
ALGO_PULSE_ALLOW_API_EXECUTION=false
ALGO_PULSE_ALLOW_NON_ALGO_STARTING_ROUTES=false
ALGO_PULSE_ALLOW_NON_ALGO_LIVE_SUBMISSION=false
ALGO_PULSE_UNSIGNED_EXECUTOR_ONLY=true

# Tiny live capital policy.
ALGO_PULSE_TINY_LIVE_MODE=true
ALGO_PULSE_TINY_LIVE_ALLOW_AUTOMATION=false
ALGO_PULSE_TINY_LIVE_MANUAL_ROUTE_HASH=
ALGO_PULSE_TINY_LIVE_LORA_TXID=
ALGO_PULSE_TINY_LIVE_RECONCILIATION_CONFIRMED=false
ALGO_PULSE_TINY_LIVE_MIN_WALLET_ALGOS=100
ALGO_PULSE_TINY_LIVE_MAX_WALLET_ALGOS=250

# Use a new tiny hot wallet only. Never use a treasury/main wallet.
# Signer secrets are provisioned outside repo-managed env files.
ALGO_PULSE_TRADER_ADDRESS=

# First trade caps.
ALGO_PULSE_MAX_LIVE_TRADE_SIZE=10
ALGO_PULSE_MAX_ROUTE_AGE_SECONDS=5
ALGO_PULSE_MAX_ROUTE_LEGS=3
ALGO_PULSE_OWN_FUNDS_ONLY=true
ALGO_PULSE_ALLOWED_APP_IDS=
ALGO_PULSE_REQUIRE_APP_ID_ALLOWLIST=true
ALGO_PULSE_MIN_FEE_BUFFER_MULTIPLIER=2
ALGO_PULSE_MIN_NET_PROFIT_ALGOS=0.25
ALGO_PULSE_MIN_NET_PROFIT_INPUT_UNITS=0.25
ALGO_PULSE_MIN_PROFIT_BPS=35
ALGO_PULSE_ESTIMATED_NETWORK_FEE_ALGOS=0.006
ALGO_PULSE_SAFETY_BUFFER_BPS=15
ALGO_PULSE_MAX_PRICE_IMPACT_BPS=50
ALGO_PULSE_MIN_POOL_RESERVE=1000
ALGO_PULSE_MAX_DAILY_LOSS=20
ALGO_PULSE_MAX_DAILY_TRADES=20
ALGO_PULSE_MAX_CONCURRENT_EXECUTION=1
ALGO_PULSE_MAX_GROUP_FEE_ALGOS=0.05

# Isolated signer remains locked until route hash review.
ALGO_PULSE_SIGNER_ENABLED=false
ALGO_PULSE_SIGNER_KILL_SWITCH=true
ALGO_PULSE_SIGNER_ALLOWED_ROUTE_HASHES=
ALGO_PULSE_SIGNER_AUDIT_LOG=/app/data/signer-audit.jsonl
ALGO_PULSE_SIGNER_MIN_WALLET_RESERVE_ALGOS=0.2
